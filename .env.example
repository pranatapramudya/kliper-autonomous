# ============================================================
#   Kliper Autonomous Engine - Environment Variables
#   Copy this file to .env and fill in your credentials.
# ============================================================

# --- Google Gemini API ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Deepgram API ---
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY_HERE

# --- Pexels API ---
# Get your key from: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# --- Telegram Bot (Command Center) ---
# 1. Buat bot baru via @BotFather di Telegram → salin token di bawah
# 2. Masukkan bot ke dalam grup Telegram Anda → jadikan Admin
# 3. Kirim pesan ke grup, lalu buka: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Salin angka "id" dari bagian "chat" (biasanya diawali tanda minus untuk grup)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_GROUP_CHAT_ID_HERE
